# Textdateien im Repo immer mit LF speichern
* text=auto eol=lf

# Windows-Skripte brauchen CRLF (cmd.exe verarbeitet Sprungmarken in LF-Dateien unzuverlässig)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell-Skripte und Git-Hooks (ohne Dateiendung) immer LF, sonst bricht die Shebang-Zeile
*.sh text eol=lf
.githooks/* text eol=lf

# Binärdateien nie verändern
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
