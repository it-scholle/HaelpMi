#!/bin/sh
# Baut die veröffentlichte Install-Creator-Kopie in tools/InstallCreator/ automatisch neu,
# sobald sich Quellcode aus src/HaelpMi.InstallCreator, src/HaelpMi.UpdateSigner oder
# Directory.Build.props seit dem letzten erfolgreichen Build geändert hat. Die eigentliche
# Logik liegt seit 26.08.2026 gemeinsam mit drei weiteren Hooks (post-rewrite, post-merge,
# post-checkout) in lib/rebuild-installcreator.sh - siehe dort für die volle Historie/
# Begründung und docs/WORKFLOW.md Abschnitt "Install-Creator-Rebuild-Hook".
#
# Aktivierung pro Checkout einmalig: git config core.hooksPath .githooks
# (siehe docs/WORKFLOW.md und BUILD-UND-INSTALLATION.md)

set -e

hook_dir=$(cd "$(dirname "$0")" && pwd)

# Nur pre-commit darf einen erkannten Hash-Mismatch (Quelle ändert sich während des Builds)
# noch hart verhindern - die anderen drei Hooks laufen nach einer bereits abgeschlossenen
# Git-Operation, dort gibt es kein "abbrechen" mehr (siehe lib/rebuild-installcreator.sh).
REBUILD_ALLOW_ABORT=1
. "$hook_dir/lib/rebuild-installcreator.sh"
