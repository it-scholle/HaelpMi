<Window x:Class="HaelpMi.InstallCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HälpMi Install-Creator"
        Width="540" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Rechter Reiter-Streifen nach Vorbild tomedo (Nutzerwunsch 14.08.2026, vierte Runde;
         Referenz-Screenshot Z:\Bildschirmfoto 2026-08-14 um 12.10.59.JPG - dort ein einzelner,
         um 90° gedrehter "Forum"-Reiter am rechten Fensterrand): Vaultwarden-Karte UND Protokoll
         teilen sich denselben Inhaltsbereich - es ist immer nur eins von beiden sichtbar, nie
         beide gleichzeitig, UND (Nutzerkorrektur 15.08.2026, fünfte Runde) auch standardmäßig
         KEINS von beiden - die Startansicht zeigt nur die Einstellungen-Spalte + den leeren
         Reiter-Streifen, exakt wie im tomedo-Referenzbild. Zwei gedrehte Reiter
         (VaultwardenTabButton oben, LogsTabButton darunter) im schmalen Streifen ganz rechts
         schalten um; erneutes Klicken auf den gerade aktiven Reiter klappt ihn wieder ein. Die
         inhaltliche Neugestaltung der Vaultwarden-Karte selbst (Grundeinstellungen hinter einem
         Zahnrad, gesperrt/entsperrt-Zustände, Schlüssel-Status-Icon statt Klartext-Anzeige,
         Archivieren statt Überschreiben beim Rotieren) ist Teil dieser fünften Runde, siehe
         Kommentare weiter unten bei VaultwardenPanel. -->
    <!-- Fünfte Runde, Kontext zur Vaultwarden-Neugestaltung: die Update-Signatur ist
         architektonisch strikt ein einziger globaler Schlüssel (ein Vaultwarden-Notizname, eine
         Public-Key-Konstante im Client, siehe HaelpMi.Core/Updates/UpdateSignaturePublicKey.cs) -
         eine echte Mehrschlüssel-Vertrauensliste wäre ein eigener, sicherheitsrelevanter Task
         und bewusst NICHT Teil dieser Änderung. Stattdessen: kein Schlüsselwert wird je
         angezeigt (Schutz gegen Mitlesen), nur ein farbiges Status-Icon; beim Erzeugen eines
         neuen Schlüssels wird der alte nicht überschrieben, sondern in Vaultwarden unter einem
         "-deprecated-<Zeitstempel>"-Namen archiviert (revisionssicher nachvollziehbar, ohne dass
         Install-Creator selbst einen Schlüssel-Browser bauen muss - siehe VaultwardenClient für
         den genauen bw-CLI-Ablauf). -->
    <!-- Sechste Runde (Nutzerkorrektur 15.08.2026): "eingeklappt" hieß bisher nur, dass der
         INHALT weg ist - die rechte Fensterhälfte blieb als leerer weißer Platz stehen (Spalte 0
         der Grid.Column="2"-Zelle unten ist "*" und füllt den Rest des Fensters, auch ohne
         sichtbaren Inhalt). Jetzt schrumpft das ganze FENSTER mit: Startbreite 540 statt 1000
         (die Einstellungen-Spalte + der schmale Reiter-Streifen brauchen nicht mehr), ein Klick
         auf einen Reiter lässt es auf die bekannten 1000 wachsen (siehe
         MainWindow.xaml.cs, UpdateWindowWidthForTabState). Kein XAML-Umbau nötig dafür - die
         "*"-Spalte schrumpft von selbst auf 0, sobald das Fenster selbst schmaler wird, die feste
         Reiter-Streifen-Spalte daneben behält ihre Breite. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="Assets/haelpmi_icon.ico" Width="36" Height="36" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="HälpMi Install-Creator" FontSize="19" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           Text="Entwickler-Werkzeug - nicht Teil der Kunden-Auslieferung" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Spalte 1: Build-Einstellungen (Test-Installer/Update-Ei/Kundenname/Passwort) plus
                 die beiden Build-Buttons und die Baustatus-Karte. -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <!-- Nutzerwunsch 15.08.2026: Klammer-Erklärung raus, die selbsterklärend
                             ist (was "Test-Installer" tut, steht bei Bedarf nur noch im Tooltip,
                             nicht mehr fest im sichtbaren Text). -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <CheckBox x:Name="TestInstallerCheckBox" IsChecked="True"
                                      Content="Test-Installer"
                                      ToolTip="Kein Passwort nötig - für internes Testen, niemals an einen Kunden ausliefern." />
                        </StackPanel>

                        <!-- Die frühere "Update-Ei"-Checkbox ist raus (Nutzerwunsch 16.08.2026):
                             das eingebettete Startpaket kostet nichts, wenn es immer dabei ist -
                             jeder Admin-Installer-Build bettet es jetzt automatisch ein, sofern ein
                             Update-Schlüssel geladen ist (siehe "Vaultwarden"-Reiter rechts). Für
                             die neue, davon unabhängige Self-Bootstrap-Update-Datei siehe den
                             "Update erstellen"-Knopf unten. -->

                        <TextBlock Text="Kundenname (Pflicht bei Produktiv-Installer; bei Test-Installer optionale Bezeichnung z. B. &quot;Testgruppe 3&quot;)"
                                   FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                        <TextBox x:Name="CustomerNameBox" Margin="0,6,0,16" />

                        <TextBlock Text="Admin-Installer-Passwort (Pflicht außer bei Test-Installer)" FontWeight="SemiBold" FontSize="12" />
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Bugfix 06.08.2026 (Fehlerbericht "Kopieren wirft immer noch einen
                                 Error", zweite Runde): PasswordBox UND ein normales TextBox liegen
                                 übereinander in derselben Zelle, per Häkchen umgeschaltet - der
                                 bisherige Fallback-Text ("Passwort manuell markieren/kopieren")
                                 war schlicht nicht umsetzbar, WPFs PasswordBox blockt Strg+C
                                 absichtlich (Schutz gegen Mitlesen). Mit "anzeigen" gibt es jetzt
                                 einen echten Weg, das Passwort notfalls von Hand zu kopieren, wenn
                                 die automatische Zwischenablage (wieder) an hartnäckiger
                                 VM-Synchronisation scheitert. -->
                            <PasswordBox Grid.Column="0" x:Name="PasswordBox" Margin="0,0,8,0" PasswordChanged="PasswordBox_PasswordChanged" />
                            <TextBox Grid.Column="0" x:Name="PasswordRevealBox" Margin="0,0,8,0" Visibility="Collapsed" TextChanged="PasswordRevealBox_TextChanged" />
                            <!-- Nutzerwunsch 09.08.2026: die drei Buttons werden Icon-only (siehe
                                 haelpmi-icon-button-preference-Notiz) - gezeichnete Vektorformen statt
                                 Text, aus demselben Grund wie beim "+"/"-" im Admin-Dashboard
                                 (NewProfileButton/DeleteProfileIconButton): Font-Metriken/Emoji-
                                 Glyphen sind in schmalen Buttons nicht zuverlässig genug, ein
                                 gezeichnetes Icon dagegen immer scharf und größenunabhängig.
                                 Width/Height=32, Padding=0: gleiches Muster wie dort. -->
                            <Button Grid.Column="1" x:Name="RevealPasswordToggle" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                                    ToolTip="Passwort anzeigen (zum manuellen Markieren/Kopieren, falls die Zwischenablage nicht mitmacht)"
                                    Click="RevealPasswordToggle_Click">
                                <Grid Width="16" Height="16">
                                    <!-- Auge geöffnet: Standardzustand (Passwort verborgen), Klick zeigt es an. -->
                                    <Grid x:Name="EyeOpenIcon">
                                        <Ellipse Width="16" Height="9" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                    <!-- Auge durchgestrichen: Passwort ist sichtbar, Klick verbirgt es wieder. -->
                                    <Grid x:Name="EyeClosedIcon" Visibility="Collapsed">
                                        <Ellipse Width="16" Height="9" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource TextPrimaryBrush}" />
                                        <Line X1="1" Y1="15" X2="15" Y2="1" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6" />
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" x:Name="GeneratePasswordButton" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                                    ToolTip="Zufälliges Passwort generieren" Click="GeneratePasswordButton_Click">
                                <!-- Zwei Würfel: hinterer oben links (Auge "1"), vorderer unten
                                     rechts (Auge "2") - eigener Hintergrund am vorderen Würfel, damit
                                     er den hinteren sichtbar überlappt statt nur die Umrisse zu kreuzen. -->
                                <Grid Width="16" Height="16">
                                    <Border Width="9" Height="9" CornerRadius="2" BorderThickness="1.2"
                                            BorderBrush="{StaticResource TextPrimaryBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Ellipse Width="2" Height="2" Fill="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Width="9" Height="9" CornerRadius="2" BorderThickness="1.2"
                                            BorderBrush="{StaticResource TextPrimaryBrush}" Background="{StaticResource SecondaryButtonBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Grid>
                                            <Ellipse Width="1.8" Height="1.8" Fill="{StaticResource TextPrimaryBrush}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.4,1.4,0,0" />
                                            <Ellipse Width="1.8" Height="1.8" Fill="{StaticResource TextPrimaryBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1.4,1.4" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Grid.Column="3" x:Name="CopyPasswordButton" Width="32" Height="32" Padding="0"
                                    ToolTip="Passwort in die Zwischenablage kopieren" Click="CopyPasswordButton_Click">
                                <!-- Zwei hintereinanderliegende Blätter: hinteres oben rechts lugt
                                     hervor, vorderes unten links deckt es teilweise ab (übliches
                                     Kopieren-Symbol). -->
                                <Grid Width="16" Height="16">
                                    <Border Width="9" Height="11" CornerRadius="1.5" BorderThickness="1.3"
                                            BorderBrush="{StaticResource TextPrimaryBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Border Width="9" Height="11" CornerRadius="1.5" BorderThickness="1.3"
                                            BorderBrush="{StaticResource TextPrimaryBrush}" Background="{StaticResource SecondaryButtonBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock Margin="0,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                   Text="Wird nirgends zentral gespeichert (kein Log, keine Datei) - nach dem Schließen dieses Fensters ist es nicht mehr abrufbar. Rechtzeitig kopieren/weitergeben." />
                        <!-- Nutzerfrage 06.08.2026: gilt bewusst NUR für den Admin-Installer (der App-
                             Admin-Rolle vergibt), nicht für den eingebetteten User-Installer - der wird
                             ohnehin erst NACH einer erfolgreichen Admin-Installation über "User-
                             Installer exportieren" im Dashboard erzeugt/verteilt, ein zusätzliches
                             Passwort dort bringt keinen Sicherheitsgewinn, nur Verteil-Reibung
                             (Passwort müsste an jeden Endnutzer mitgegeben werden). -->
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                                   Text="Gilt nur für den Admin-Installer. Der User-Installer bleibt immer passwortfrei - er wird erst nach erfolgreicher Admin-Installation im Dashboard erzeugt und an bereits vertrautem Weg verteilt." />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                    <Button x:Name="BuildAdminButton" Content="Admin-Installer erstellen" HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}" Padding="18,9" Margin="0,0,8,0" Click="BuildAdminButton_Click" />

                    <!-- "Update erstellen" (Nutzerwunsch 16.08.2026, ersetzt die frühere
                         "Update-Ei"-Checkbox): baut eine einzelne, eigenständig lauffähige .exe -
                         signiertes Update-Paket eingebettet (siehe UpdatePackageBuilder.
                         AppendUpdatePackage/HaelpMi.UpdateBootstrapper). Der Admin bekommt genau
                         diese eine Datei, führt sie auf einer bereits installierten Maschine aus -
                         die aktualisiert sich sofort selbst UND steht danach im "Updates"-Tab des
                         Admin-Dashboards zur Freigabe bereit. Braucht einen geladenen
                         Update-Schlüssel (siehe "Vaultwarden"-Reiter rechts). -->
                    <Button x:Name="CreateUpdateBootstrapperButton" Content="Update erstellen" HorizontalAlignment="Left"
                            Padding="18,9" IsEnabled="False" Click="CreateUpdateBootstrapperButton_Click"
                            ToolTip="Baut eine einzelne Datei, die ein Admin auf einer bereits installierten Maschine ausführt - sie aktualisiert sich sofort selbst und macht die Version für die Freigabe im Dashboard verfügbar." />
                </StackPanel>

                <!-- Schlanker Weg (Nutzerwunsch 13.08.2026): nur ein Update-Paket veröffentlichen,
                     ohne ISCC/Kundengruppen-ID/Installer-Passwort - für den Normalfall "neue
                     Version an bereits installierte Geräte verteilen" statt "neuen Installer für
                     einen neuen Kunden bauen". Braucht ebenfalls einen geladenen Update-Schlüssel. -->
                <Button x:Name="PublishUpdatePackageButton" Content="Update-Paket veröffentlichen" HorizontalAlignment="Left"
                        Padding="18,9" Margin="0,0,0,16" IsEnabled="False" Click="PublishUpdatePackageButton_Click" />

                <!-- Nutzerwunsch 06.08.2026: der Erfolgs-Toast (BuildSuccessToastWindow) schließt
                     nach 8s automatisch - wer ihn übersieht, hatte bisher keine zweite Chance, an
                     die fertige Datei zu kommen außer im Protokoll nachzulesen. Bleibt jetzt hier
                     dauerhaft stehen (bis zum nächsten Build), an der Stelle, die die entfernten
                     Beschreibungstexte freigemacht haben. -->
                <Border x:Name="LastBuildPanel" Visibility="Collapsed" Background="{StaticResource SuccessLightBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="LastBuildTitleText" Text="Admin-Installer erstellt" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="LastBuildFileText" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Button x:Name="LastBuildShowButton" Content="Anzeigen" HorizontalAlignment="Left"
                                Padding="14,6" Click="LastBuildShowButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Spalte 2: Inhaltsbereich (Vaultwarden ODER Protokoll, nie beide) plus rechter
                 Reiter-Streifen zum Umschalten - siehe Kommentar oben am Fensteranfang. -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Update-Signatur/Vaultwarden (Nutzerwunsch 13.08.2026): der private
                     Update-Signaturschlüssel liegt in Vaultwarden statt als Klartextdatei auf
                     dieser Maschine. Komplett eingeklappt, bis der "Vaultwarden"-Reiter rechts
                     angeklickt wird - kein automatisches Anbieten "beim Boot" mehr. -->
                <Border Grid.Column="0" x:Name="VaultwardenPanel" Visibility="Collapsed"
                        Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Kopfzeile: Titel links, Zahnrad rechts (Nutzerwunsch 15.08.2026,
                             fünfte Runde) - blendet VaultwardenBasicSettingsPanel (Server-URL/
                             E-Mail) ein/aus. Kein "Namensschema"-Feld dort (vom Nutzer bewusst
                             verworfen - redundant, es gibt ohnehin nur den einen Schlüssel). -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Update-Signatur (Vaultwarden)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <Button x:Name="VaultwardenSettingsToggle" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="32" Height="32" Padding="0"
                                    ToolTip="Grundeinstellungen (Vaultwarden-Server-URL/Konto-E-Mail) ein-/ausblenden"
                                    Click="VaultwardenSettingsToggle_Click">
                                <!-- Zahnrad: Ring + Nabe + vier radiale Striche - einfache
                                     Näherung im selben Abstraktionsgrad wie das Würfel-Icon
                                     oben links (GeneratePasswordButton), kein Vollbild-Zahnrad. -->
                                <Grid Width="16" Height="16">
                                    <Ellipse Width="10" Height="10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextPrimaryBrush}" />
                                    <Line X1="8" Y1="0" X2="8" Y2="2.5" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                    <Line X1="8" Y1="13.5" X2="8" Y2="16" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                    <Line X1="0" Y1="8" X2="2.5" Y2="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                    <Line X1="13.5" Y1="8" X2="16" Y2="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12"
                                   Text="Der private Schlüssel liegt verschlüsselt in Vaultwarden (Notiz &quot;HälpMi-Update-PrivateKey&quot;) und wird nur für diesen Programmlauf in den Speicher geladen - nie als Datei auf dieser Maschine." />

                        <StackPanel x:Name="VaultwardenBasicSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="Vaultwarden-Server-URL" FontWeight="SemiBold" FontSize="12" />
                            <TextBox x:Name="VaultwardenServerBox" Margin="0,6,0,12" />

                            <TextBlock Text="Konto-E-Mail" FontWeight="SemiBold" FontSize="12" />
                            <TextBox x:Name="VaultwardenEmailBox" Margin="0,6,0,12" />
                        </StackPanel>

                        <!-- Gesperrter Zustand (Default beim Öffnen des Reiters, außer diese
                             Sitzung hat schon einmal erfolgreich entsperrt - siehe
                             VaultwardenTabButton_Click). Eigenes Statusfeld
                             (VaultwardenLockedStatusText) statt des weiter unten liegenden
                             VaultwardenStatusText, weil letzteres erst im entsperrten Panel
                             lebt und hier noch unsichtbar wäre - Fehlermeldungen (falsches
                             Passwort, bw.exe fehlt, ...) müssen aber genau in diesem Zustand
                             sichtbar sein. -->
                        <StackPanel x:Name="VaultwardenLockedPanel">
                            <TextBlock Text="Master-Passwort" FontWeight="SemiBold" FontSize="12" />
                            <PasswordBox x:Name="VaultwardenPasswordBox" Margin="0,6,0,12" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="VaultwardenUnlockButton" Content="Vault entsperren und Schlüssel laden" Style="{StaticResource AccentButtonStyle}"
                                        Padding="14,7" Margin="0,0,8,0" Click="VaultwardenUnlockButton_Click" />
                                <Button x:Name="VaultwardenSkipButton" Content="Überspringen" Padding="14,7" Click="VaultwardenSkipButton_Click" />
                            </StackPanel>

                            <TextBlock x:Name="VaultwardenLockedStatusText" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>

                        <!-- Entsperrter Zustand: kein Schlüsselwert wird je angezeigt (Schutz
                             gegen Mitlesen, Nutzerwunsch 15.08.2026) - nur ein farbiges Status-
                             Icon (grün = vorhanden, rot = nicht vorhanden), gleiches
                             Überlappungs-/Visibility-Muster wie EyeOpenIcon/EyeClosedIcon oben. -->
                        <StackPanel x:Name="VaultwardenUnlockedPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <Grid x:Name="KeyPresentIcon" Visibility="Collapsed">
                                        <Ellipse Width="7" Height="7" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Line X1="6" Y1="8" X2="15" Y2="8" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6" />
                                        <Line X1="11" Y1="8" X2="11" Y2="12" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6" />
                                        <Line X1="14" Y1="8" X2="14" Y2="11" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6" />
                                    </Grid>
                                    <Grid x:Name="KeyMissingIcon" Visibility="Collapsed">
                                        <Ellipse Width="7" Height="7" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Line X1="6" Y1="8" X2="15" Y2="8" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" />
                                        <Line X1="11" Y1="8" X2="11" Y2="12" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" />
                                        <Line X1="14" Y1="8" X2="14" Y2="11" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" />
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="1" x:Name="VaultwardenStatusText" TextWrapping="Wrap" FontSize="12"
                                           Text="Kein Schlüssel geladen." />
                            </Grid>

                            <Button x:Name="GenerateUpdateKeyButton" Content="Neuen Schlüssel erzeugen" HorizontalAlignment="Left"
                                    Padding="14,7" IsEnabled="False" Click="GenerateUpdateKeyButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Protokoll: wie Vaultwarden standardmäßig eingeklappt (Nutzerkorrektur
                     15.08.2026, fünfte Runde - vorher war Visibility hier "Visible"), über den
                     "Logs"-Reiter einklappbar - beide teilen sich diese Zelle, es ist immer
                     höchstens eins der beiden sichtbar, anfangs keins. -->
                <DockPanel Grid.Column="0" x:Name="LogPanel" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="Protokoll" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#F4F6F6" />
                </DockPanel>

                <TextBlock x:Name="VersionText" Grid.Column="0" Style="{StaticResource VersionWatermarkStyle}" />

                <!-- Reiter-Streifen ganz rechts, nach tomedo-Vorbild (siehe Kommentar oben):
                     dünne Trennlinie links, zwei um 90° gedrehte Text-Reiter übereinander. -->
                <Border Grid.Column="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
                    <StackPanel Orientation="Vertical" Margin="4,0,0,0">
                        <Button x:Name="VaultwardenTabButton" Width="28" Padding="4,10"
                                ToolTip="Vaultwarden-Konfiguration ein-/ausklappen" Click="VaultwardenTabButton_Click">
                            <TextBlock Text="Vaultwarden" FontSize="12">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Button>
                        <Button x:Name="LogsTabButton" Width="28" Padding="4,10" Margin="0,8,0,0"
                                ToolTip="Protokoll ein-/ausklappen" Click="LogsTabButton_Click">
                            <TextBlock Text="Logs" FontSize="12">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
