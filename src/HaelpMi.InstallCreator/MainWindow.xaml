<Window x:Class="HaelpMi.InstallCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HaelpMi.InstallCreator.Controls"
        Title="HälpMi Install-Creator"
        Width="1000" Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Breitbild statt Hochformat (Nutzerwunsch 06.08.2026): links wie bisher Kundenname/
         Checkbox/Passwort, rechts auf voller Fensterhöhe das Protokoll. Vorher stand das Log
         unten in einer festen 220px-Box, obwohl rechts daneben nur Leerraum war - bei einem
         längeren Build-Log (Payload+Admin-Installer nacheinander, siehe BuildAdminButton_Click)
         war das ein unnötig enges Scroll-Feld. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Zweiter Reiter "Lizenzen" (Issue #18) - Höhe deshalb 640->680, damit für den
         Tab-Kopf kein Content beengt wird. -->
    <TabControl>
    <TabItem Header="Installer erstellen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Image Source="Assets/haelpmi_icon.ico" Width="36" Height="36" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HälpMi Install-Creator" FontSize="19" FontWeight="Bold" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               Text="Entwickler-Werkzeug - nicht Teil der Kunden-Auslieferung" />
                </StackPanel>
            </StackPanel>
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,16">
                <StackPanel>
                    <CheckBox x:Name="TestInstallerCheckBox" IsChecked="True" Margin="0,0,0,16"
                              Content="Test-Installer" />

                    <TextBlock Text="Kundenname"
                               FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                    <TextBox x:Name="CustomerNameBox" Margin="0,6,0,16" />

                    <TextBlock Text="Kundennummer (dem Kunden sichtbar statt der internen Kundengruppen-ID)"
                               FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                    <TextBox x:Name="CustomerNumberBox" Margin="0,6,0,16" />

                    <TextBlock Text="Admin-Installer-Passwort (Pflicht außer bei Test-Installer)" FontWeight="SemiBold" FontSize="12" />
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Bugfix 06.08.2026 (Fehlerbericht "Kopieren wirft immer noch einen
                             Error", zweite Runde): PasswordBox UND ein normales TextBox liegen
                             übereinander in derselben Zelle, per Häkchen umgeschaltet - der
                             bisherige Fallback-Text ("Passwort manuell markieren/kopieren")
                             war schlicht nicht umsetzbar, WPFs PasswordBox blockt Strg+C
                             absichtlich (Schutz gegen Mitlesen). Mit "anzeigen" gibt es jetzt
                             einen echten Weg, das Passwort notfalls von Hand zu kopieren, wenn
                             die automatische Zwischenablage (wieder) an hartnäckiger
                             VM-Synchronisation scheitert. -->
                        <PasswordBox Grid.Column="0" x:Name="PasswordBox" Margin="0,0,8,0" PasswordChanged="PasswordBox_PasswordChanged" />
                        <TextBox Grid.Column="0" x:Name="PasswordRevealBox" Margin="0,0,8,0" Visibility="Collapsed" TextChanged="PasswordRevealBox_TextChanged" />
                        <!-- Nutzerwunsch 09.08.2026: die drei Buttons werden Icon-only (siehe
                             haelpmi-icon-button-preference-Notiz) - gezeichnete Vektorformen statt
                             Text, aus demselben Grund wie beim "+"/"-" im Admin-Dashboard
                             (NewProfileButton/DeleteProfileIconButton): Font-Metriken/Emoji-
                             Glyphen sind in schmalen Buttons nicht zuverlässig genug, ein
                             gezeichnetes Icon dagegen immer scharf und größenunabhängig.
                             Width/Height=32, Padding=0: gleiches Muster wie dort. -->
                        <Button Grid.Column="1" x:Name="RevealPasswordToggle" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                                ToolTip="Passwort anzeigen (zum manuellen Markieren/Kopieren, falls die Zwischenablage nicht mitmacht)"
                                Click="RevealPasswordToggle_Click">
                            <Grid Width="16" Height="16">
                                <!-- Auge geöffnet: Standardzustand (Passwort verborgen), Klick zeigt es an. -->
                                <Grid x:Name="EyeOpenIcon">
                                    <Ellipse Width="16" Height="9" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                                <!-- Auge durchgestrichen: Passwort ist sichtbar, Klick verbirgt es wieder. -->
                                <Grid x:Name="EyeClosedIcon" Visibility="Collapsed">
                                    <Ellipse Width="16" Height="9" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" />
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextPrimaryBrush}" />
                                    <Line X1="1" Y1="15" X2="15" Y2="1" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6" />
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Grid.Column="2" x:Name="GeneratePasswordButton" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                                ToolTip="Zufälliges Passwort generieren" Click="GeneratePasswordButton_Click">
                            <!-- Zwei Würfel: hinterer oben links (Auge "1"), vorderer unten
                                 rechts (Auge "2") - eigener Hintergrund am vorderen Würfel, damit
                                 er den hinteren sichtbar überlappt statt nur die Umrisse zu kreuzen. -->
                            <Grid Width="16" Height="16">
                                <Border Width="9" Height="9" CornerRadius="2" BorderThickness="1.2"
                                        BorderBrush="{StaticResource TextPrimaryBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Ellipse Width="2" Height="2" Fill="{StaticResource TextPrimaryBrush}" />
                                </Border>
                                <Border Width="9" Height="9" CornerRadius="2" BorderThickness="1.2"
                                        BorderBrush="{StaticResource TextPrimaryBrush}" Background="{StaticResource SecondaryButtonBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Grid>
                                        <Ellipse Width="1.8" Height="1.8" Fill="{StaticResource TextPrimaryBrush}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.4,1.4,0,0" />
                                        <Ellipse Width="1.8" Height="1.8" Fill="{StaticResource TextPrimaryBrush}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1.4,1.4" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Grid.Column="3" x:Name="CopyPasswordButton" Width="32" Height="32" Padding="0"
                                ToolTip="Passwort in die Zwischenablage kopieren" Click="CopyPasswordButton_Click">
                            <!-- Zwei hintereinanderliegende Blätter: hinteres oben rechts lugt
                                 hervor, vorderes unten links deckt es teilweise ab (übliches
                                 Kopieren-Symbol). -->
                            <Grid Width="16" Height="16">
                                <Border Width="9" Height="11" CornerRadius="1.5" BorderThickness="1.3"
                                        BorderBrush="{StaticResource TextPrimaryBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <Border Width="9" Height="11" CornerRadius="1.5" BorderThickness="1.3"
                                        BorderBrush="{StaticResource TextPrimaryBrush}" Background="{StaticResource SecondaryButtonBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="BuildAdminButton" Content="Admin-Installer erstellen" HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}" Padding="18,9" Margin="0,0,0,16" Click="BuildAdminButton_Click" />

            <!-- Nutzerwunsch 06.08.2026: der Erfolgs-Toast (BuildSuccessToastWindow) schließt
                 nach 8s automatisch - wer ihn übersieht, hatte bisher keine zweite Chance, an
                 die fertige Datei zu kommen außer im Protokoll nachzulesen. Bleibt jetzt hier
                 dauerhaft stehen (bis zum nächsten Build), an der Stelle, die die entfernten
                 Beschreibungstexte freigemacht haben. -->
            <Border x:Name="LastBuildPanel" Visibility="Collapsed" Background="{StaticResource SuccessLightBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Admin-Installer erstellt" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="LastBuildFileText" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LastBuildShowButton" Content="Anzeigen" HorizontalAlignment="Left"
                                Padding="14,6" Click="LastBuildShowButton_Click" />
                        <Button x:Name="LastBuildMoveButton" Content="Nach Z: verschieben" HorizontalAlignment="Left"
                                Padding="14,6" Margin="8,0,0,0" Click="LastBuildMoveButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Protokoll" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" Background="#F4F6F6" />
        </DockPanel>

        <!-- Nutzerwunsch 20.08.2026: aus der rechten Protokoll-Spalte in die linke Spalte
             (unten rechts) verschoben - Grid.Column="0" ohne eigene Zeilendefinition nimmt
             dieselbe volle Höhe wie die dortige StackPanel-Zelle ein, VerticalAlignment=Bottom
             kombiniert mit dem HorizontalAlignment=Right aus VersionWatermarkStyle setzt den
             Text damit in die untere rechte Ecke der linken Spalte. -->
        <TextBlock x:Name="VersionText" Grid.Column="0" VerticalAlignment="Bottom" Style="{StaticResource VersionWatermarkStyle}" />
    </Grid>
    </TabItem>

    <TabItem Header="Lizenzen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Kunden" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox x:Name="LicenseCustomerListBox" SelectionChanged="LicenseCustomerListBox_SelectionChanged" />
        </DockPanel>

        <!-- Nutzerfeedback 01.09.2026: die Lizenzhistorie ganz unten war bei fixer
             Fensterhöhe (ResizeMode="NoResize") unauffindbar - StackPanel-Inhalt reichte
             über den sichtbaren Bereich hinaus, ohne Scrollbar zum Nachscrollen. -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Neue Lizenz erstellen" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock x:Name="LicenseSelectedCustomerText" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" Text="Kein Kunde ausgewählt" Margin="0,0,0,16" />

            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Issue #46: fertige, eigenständige Control statt einer eigenen zweiten
                         Tier-Auswahl - vermeidet eine zweite LicenseTier-Enum im selben Projekt. -->
                    <controls:LicenseTierPicker x:Name="TierPicker" Margin="0,0,0,16" />

                    <!-- Kein Standard-Laufzeit-Vorschlag (Nutzer-Entscheidung 27.08.2026, auch
                         nicht für Trial) - DatePicker startet deshalb bewusst leer. Ersatz durch
                         Toggle Tage/Monatsende + Datepicker-Komfort: eigenes Ticket #47. -->
                    <TextBlock Text="Ablaufdatum" FontWeight="SemiBold" FontSize="12" />
                    <DatePicker x:Name="LicenseExpiryDatePicker" Margin="0,6,0,16" />

                    <!-- Nutzerfeedback 27.08.2026: "Lizenzschlüssel" klang wie die zu erstellende
                         Lizenz selbst (Verwechslung mit einem klassischen Produktschlüssel) -
                         das hier ist der private Anbieter-Signaturschlüssel (Ed25519), mit dem
                         jede Lizenz signiert wird, vergleichbar einem Code-Signing-Zertifikat. -->
                    <TextBlock Text="Signaturschlüssel (privat)" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="Der Anbieter-Schlüssel, mit dem die Lizenz signiert wird - nicht die Lizenz selbst."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="LoadLicenseKeyButton" Content="Schlüsseldatei laden..."
                                Padding="14,6" Click="LoadLicenseKeyButton_Click" />
                        <TextBlock Grid.Column="1" x:Name="LicenseKeyStatusText" Text="kein Signaturschlüssel geladen"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="CreateLicenseButton" Content="Lizenz erstellen" HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}" Padding="18,9" Margin="0,0,0,8"
                    Click="CreateLicenseButton_Click" />
            <TextBlock x:Name="LicenseStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Issue #54-Nacharbeit (01.09.2026, Nutzerentscheidung): Lizenz als kompakter
                 Text statt Datei - direkt per E-Mail verschickbar, kein Datei-Dialog nötig
                 (löst dabei auch das dortige "Zuletzt verwendet"-Problem an der Wurzel). -->
            <StackPanel x:Name="LicenseKeyResultPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <TextBlock Text="Lizenzschlüssel (an den Kunden zu übermitteln, z. B. per E-Mail)"
                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                <TextBox x:Name="LicenseKeyResultTextBox" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" Margin="0,0,0,8" />
                <Button x:Name="CopyLicenseKeyButton" Content="In Zwischenablage kopieren" HorizontalAlignment="Left"
                        Padding="14,6" Click="CopyLicenseKeyButton_Click" />
            </StackPanel>

            <TextBlock Text="Bisher ausgestellte Lizenzen" FontWeight="SemiBold" Margin="0,0,0,6" />
            <!-- Nutzerwunsch 01.09.2026: jede Zeile zeigt Paketgröße+Datum und lässt sich
                 einzeln erneut kopieren (LicenseHistoryItem), ohne neu zu signieren. -->
            <ListBox x:Name="LicenseHistoryListBox" Height="160" Margin="0,0,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                       FontSize="11" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                                    ToolTip="Lizenzschlüssel in die Zwischenablage kopieren"
                                    Click="HistoryCopyButton_Click">
                                <Grid Width="12" Height="12">
                                    <Border Width="7" Height="9" CornerRadius="1.2" BorderThickness="1"
                                            BorderBrush="{StaticResource TextPrimaryBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Border Width="7" Height="9" CornerRadius="1.2" BorderThickness="1"
                                            BorderBrush="{StaticResource TextPrimaryBrush}" Background="{StaticResource SecondaryButtonBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        </ScrollViewer>
    </Grid>
    </TabItem>
    </TabControl>
</Window>
