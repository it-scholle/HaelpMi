<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:HaelpMi.UI.Helpers">

    <!-- Schlankes, helles Farbschema (Nutzerwunsch: "Apple-artig") - ein Akzentton statt
         der bisherigen Vielzahl an Ad-hoc-Hex-Farben je Button. Bestehende, semantisch
         wichtige Inline-Farben (Alarm-Rot, Erfolgs-Grün im Toast, ...) bleiben an ihren
         Stellen unverändert bestehen, da lokale Werte diese Styles ohnehin überschreiben -
         hier geht es nur um die Form (Ecken, Abstände, Typografie), nicht um jede Farbe. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#D2D2D7" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0071E3" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005BBF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <!-- Nutzerwunsch 04.08.2026: "leicht grün hinterlegt" für aktiv/zugeordnete Einträge
         in Toggle-Listen (Empfänger-/Gruppen-Zuordnung) - blasser als SuccessBrush, da es
         eine ganze Zeile füllt statt eines kleinen Icons/Buttons. -->
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#D6F5DD" />
    <!-- Nutzerwunsch 04.08.2026 (Sender-Auswahl im Alarm-Profil): "gerade zur Bearbeitung
         ausgewählt" braucht eine eigene Farbe, die nicht mit Grün (= Empfänger zugeordnet)
         oder dem fett+Badge-Zustand (= Sender hat bereits Empfänger) verwechselt wird -
         blasses Blau, abgeleitet von AccentBrush. -->
    <SolidColorBrush x:Key="AccentLightBrush" Color="#D6E9FA" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#E8E8ED" />

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Nutzerwunsch 05.08.2026: Versionsnummer dezent in einer Ecke jedes Hauptfensters -
         grau, gedämpfte Deckkraft, unten rechts. IsHitTestVisible=False, damit sie nie
         Klicks/Drag-and-Drop im darunterliegenden Inhalt abfängt. -->
    <Style x:Key="VersionWatermarkStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Panel.ZIndex" Value="99" />
    </Style>

    <!-- Flacher, abgerundeter Button ohne WPF-Standard-Chrome - lokale Background-Werte
         (z. B. bestehende Akzentfarben je Aktion) bleiben wirksam, nur Form/Hover ändert sich. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Für Primäraktionen: Style="{StaticResource AccentButtonStyle}" statt eigener Hex-Farbe. -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Bewusst nur leichte Eingriffe (Farben/Ränder, kein ControlTemplate) bei
         ListBox/DataGrid/GroupBox/TabControl - ein volles Retemplate dieser komplexeren
         Controls lässt sich ohne visuelle Iteration am realen Fenster (Drag-and-Drop-Popups,
         DataGrid-Spalten-Interaktion) zu leicht kaputt machen; die Grundfarben/-radien
         reichen für den gewünschten Gesamteindruck.
         ComboBox (Nutzerwunsch 08.08.2026: "noch ein default, kein schickes") ist jetzt die
         Ausnahme - eigenes flaches ControlTemplate (kein natives Windows-Chrome mehr),
         live am echten Fenster geprüft statt blind geschrieben, genau der Vorbehalt oben. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Gezeichnetes Dreieck statt Font-/Symbolzeichen - dieselbe Lehre wie beim
                                                 "+"-Button (AdminDashboardWindow): Symbol-Glyphen sind in kleinen
                                                 Controls nicht zuverlässig genug, ein gezeichnetes Shape immer. -->
                                            <Path Grid.Column="1" Data="M0,0 L7,0 L3.5,5 Z" Fill="{StaticResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                           Content="{TemplateBinding SelectionBoxItem}"
                                           ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                           ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                           Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <!-- AllowsTransparency bewusst False (nicht wie sonst bei Popups üblich True) +
                             StaysOpen False: als layered Fenster (AllowsTransparency=True) verschluckt
                             dieses Popup unter RDP/VM ohne GPU-Beschleunigung den ersten Klick auf ein
                             ComboBoxItem, SelectedItem ändert sich dann nicht. Deshalb hier auch kein
                             CornerRadius/DropShadowEffect auf der Border - beides setzt Transparenz voraus.
                             PopupNoActivateHelper zusätzlich, weil AllowsTransparency=False allein den
                             Klick unter RDP/VM nicht immer robust durchreicht - siehe Helper-Kommentar. -->
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="False" StaysOpen="False" Focusable="False"
                               PopupAnimation="Slide" IsOpen="{TemplateBinding IsDropDownOpen}"
                               helpers:PopupNoActivateHelper.Enabled="True">
                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer SnapsToDevicePixels="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="AlternatingRowBackground" Value="#FAFAFC" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource HairlineBrush}" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <!-- Nutzerwunsch 04.08.2026: "Registerkarten zu eckig" - abgerundete obere Ecken statt
         der scharfkantigen Standard-Windows-Optik. Bewusst nah am Standardverhalten (nur
         Kopf-Form + Auswahl-Farbe geändert, keine Popup-/Scroll-Mechanik angefasst), um das
         Risiko aus dem Kommentar oben (komplexe Controls ohne visuelle Iteration retempeln)
         klein zu halten. -->
    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{StaticResource SecondaryButtonBrush}" CornerRadius="10,10,0,0"
                            Margin="0,0,4,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Content" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
