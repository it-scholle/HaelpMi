<Window x:Class="HaelpMi.UI.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über HälpMi"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaelpMi.UI;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="HälpMi" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" Text="Version 0.0.0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                   Margin="0,2,0,0" />

        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />

        <TextBlock Text="KUNDENNUMMER" FontSize="10" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock x:Name="CustomerNumberText" Text="10042"
                   FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />

        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />

        <TextBlock Text="Eine Software von IT-Scholle" FontWeight="SemiBold" FontSize="13" />
        <TextBlock Text="Hannes Scholz" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
        <TextBlock Text="info@it-scholle.de" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,2,0,0" />

        <Button x:Name="CloseButton" Content="Schließen" HorizontalAlignment="Right" Padding="16,7"
                Style="{StaticResource AccentButtonStyle}" Margin="0,20,0,0" Click="CloseButton_Click" />
    </StackPanel>
</Window>
