<Window x:Class="HaelpMi.UI.Windows.LicenseRenewalMailConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HälpMi"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaelpMi.UI;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="Neue Lizenz anfordern" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"
                   Text="Es wird eine E-Mail mit folgenden Angaben vorbereitet - Sie müssen sie danach nur noch prüfen und abschicken:" />

        <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontSize="12" Margin="0,0,0,4">
                    <Run Text="An: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Run x:Name="ToText" />
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap">
                    <Run Text="Betreff: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Run x:Name="SubjectText" />
                </TextBlock>
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <TextBlock x:Name="BodyText" FontSize="11.5" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="In E-Mail-Programm öffnen?" FontWeight="SemiBold" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Abbrechen" Padding="16,7" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="OpenMailButton" Content="In Mail öffnen" Padding="16,7"
                    Style="{StaticResource AccentButtonStyle}" Click="OpenMailButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
