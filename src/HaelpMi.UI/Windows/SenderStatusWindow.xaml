<Window x:Class="HaelpMi.UI.Windows.SenderStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HälpMi"
        Width="300" SizeToContent="Height" MaxHeight="420"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaelpMi.UI;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#DD2C3E50" CornerRadius="14" Padding="14,10">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StatusText" Foreground="White" FontWeight="Bold" FontSize="14" />
                    <TextBlock x:Name="ProfileText" Foreground="#D6DBDF" FontSize="11" Margin="0,2,0,0" />
                    <TextBlock x:Name="AckedText" Foreground="#D6DBDF" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="CloseBannerButton" Content="&#10005;" Width="20" Height="20"
                        VerticalAlignment="Top" Background="Transparent" Foreground="#BDC3C7"
                        BorderThickness="0" Padding="0" Click="CloseBannerButton_Click" />
            </Grid>

            <!-- FR-53: "Auf dem Weg"-Namensliste, untereinander formatiert. -->
            <TextBlock x:Name="OnTheWayHeaderText" Text="Auf dem Weg:" Foreground="#D6DBDF" FontSize="11" FontWeight="SemiBold"
                       Margin="0,10,0,2" Visibility="Collapsed" />
            <ItemsControl x:Name="OnTheWayList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="White" FontSize="11" Margin="4,1,0,1" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- FR-50: manueller Abbrechen-Button, solange noch aktiv gesendet wird. -->
            <Button x:Name="CancelButton" Content="Abbrechen" Margin="0,12,0,0" Padding="0,6"
                    HorizontalAlignment="Stretch" Background="#C0392B" Foreground="White" BorderThickness="0"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Border>
</Window>
