<Window x:Class="HaelpMi.UI.Windows.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HälpMi - Einstellungen"
        Width="820" Height="420"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaelpMi.UI;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Allgemein: Teil 2, Abschnitt 2 - Computername/Rolle bleiben rein lesend (OS- bzw.
             Installer-bestimmt). Raum/Raumnummer sind jetzt direkt editierbar (Nutzerwunsch
             05.08.2026) statt nur zentral über das Admin-Dashboard - mit einem Hinweis-Popup
             beim ersten Bearbeiten (AdminOnlyNoticeWindow; eine spätere Version soll das über
             einen echten Windows-Admin-Prompt/UAC statt nur eines Hinweises durchsetzen).
             Alles hier speichert automatisch bei Verlassen des Feldes - kein Speichern-
             Button mehr (CLAUDE.md, wie im übrigen Dashboard). -->
        <GroupBox Grid.Row="0" Header="Allgemein - dieser Arbeitsplatz" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                    <TextBlock Text="Computername" FontWeight="SemiBold" />
                    <TextBlock x:Name="ComputerNameText" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" ToolTip="Nur durch den Administrator ändern">
                    <TextBlock Text="Raum" FontWeight="SemiBold" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RoomNameBox" Grid.Column="0" Padding="4" Margin="0,0,4,0"
                                 GotFocus="RoomField_GotFocus" LostFocus="RoomField_LostFocus" />
                        <TextBox x:Name="RoomNumberBox" Grid.Column="1" Padding="4"
                                 GotFocus="RoomField_GotFocus" LostFocus="RoomField_LostFocus" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
                    <TextBlock Text="Rolle" FontWeight="SemiBold" />
                    <TextBlock x:Name="RoleText" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                    <TextBlock Text="Signalton (eingehend)" FontWeight="SemiBold" />
                    <ComboBox x:Name="IncomingSoundCombo" Margin="0,4,0,0" DisplayMemberPath="DisplayName"
                              SelectionChanged="IncomingSoundCombo_SelectionChanged" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="SaveGeneralStatusText"
                           VerticalAlignment="Center" Margin="0,4,0,0" Foreground="Gray" />

                <!-- FR-33: nur sichtbar für Role.Admin - ConfigWindowContext.OpenAdminDashboard ist dann gesetzt. -->
                <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" x:Name="OpenAdminDashboardButton"
                        Content="Admin-Dashboard öffnen" Padding="14,6" HorizontalAlignment="Right"
                        Background="#8E44AD" Foreground="White" BorderThickness="0"
                        Visibility="Collapsed" Click="OpenAdminDashboardButton_Click" />
            </Grid>
        </GroupBox>

        <!-- Nutzerwunsch 05.08.2026: reine Lesansicht, damit der User selbst sieht, was sein
             eigener Hotkey auslöst und wer benachrichtigt wird - vorher nirgends im User-
             Fenster sichtbar, nur im Admin-Dashboard konfigurierbar. -->
        <GroupBox Grid.Row="1" Header="Meine Alarme" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Für dieses Gerät eingerichtete Alarm-Profile" FontWeight="SemiBold" />
                <ComboBox x:Name="MyAlarmsCombo" Margin="0,4,0,10" DisplayMemberPath="Name" SelectionChanged="MyAlarmsCombo_SelectionChanged" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Tastenkürzel" FontWeight="SemiBold" />
                        <TextBlock x:Name="MyAlarmHotkeyText" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Empfänger (für dieses Gerät als Sender)" FontWeight="SemiBold" />
                        <TextBlock x:Name="MyAlarmRecipientsText" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="MyAlarmsEmptyText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Für dieses Gerät ist aktuell kein Alarm-Profil als Sender eingerichtet." />
            </StackPanel>
        </GroupBox>

        <!-- Issue #61: die frühere "Individuell - bekannte Geräte"-Liste (samt Aktivieren/
             Deaktivieren/Notiz) ist von hier in den neuen Geräte-Tab des Admin-Dashboards
             umgezogen - eine reine Peer-Liste ohne Verwaltungsmöglichkeit war in einem
             Fenster ohne Admin-Rechte ohnehin nur Anzeige ohne echten Nutzen. Selbsttest und
             Erneut-Suchen bleiben hier, weil sie unabhängig von dieser Liste jedem Nutzer
             (nicht nur Admins) zur Verfügung stehen sollen. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SelfTestButton" Content="Selbsttest" Padding="14,6" Margin="0,0,8,0" Click="SelfTestButton_Click" />
            <Button x:Name="SearchAgainButton" Content="Erneut suchen" Padding="14,6" Click="SearchAgainButton_Click" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource VersionWatermarkStyle}" Margin="8,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
