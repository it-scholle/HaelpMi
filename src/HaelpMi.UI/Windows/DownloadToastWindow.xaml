<Window x:Class="HaelpMi.UI.Windows.DownloadToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HälpMi"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaelpMi.UI;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#DD1E8449" CornerRadius="14" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="&#10003;" FontSize="24" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Top" Margin="0,0,10,0" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="SubText" Foreground="#D5F5E3" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />
                <Button x:Name="OpenFolderButton" Content="Ordner öffnen" HorizontalAlignment="Left" Padding="10,4"
                        Background="White" Foreground="#1E8449" BorderThickness="0" FontWeight="SemiBold"
                        Click="OpenFolderButton_Click" />
            </StackPanel>

            <Button Grid.Column="2" x:Name="CloseButton" Content="&#10005;" Width="20" Height="20"
                    VerticalAlignment="Top" Background="Transparent" Foreground="#D5F5E3" BorderThickness="0"
                    Padding="0" Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>
