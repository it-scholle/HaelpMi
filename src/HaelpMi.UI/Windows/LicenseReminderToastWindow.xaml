<Window x:Class="HaelpMi.UI.Windows.LicenseReminderToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HälpMi"
        Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <!-- Issue #20-Nacharbeit: Systemstart-Erinnerung vor Lizenzablauf - gleiches
         Toast-Muster wie DownloadToastWindow (unten rechts einschwebend), aber OHNE
         Auto-Close-Timer: bleibt stehen, bis "Später erinnern"/Dashboard-öffnen/X
         geklickt wird - nur "Später erinnern" unterdrückt die nächste Anzeige
         (siehe LicenseReminderStateStore). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaelpMi.UI;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="RootBorder" CornerRadius="14" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Lizenz" Foreground="White" FontWeight="Bold" FontSize="13" />
                <TextBlock x:Name="MessageText" Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="Dashboard öffnen" Padding="10,4" Margin="0,0,8,0"
                            Background="White" FontWeight="SemiBold" BorderThickness="0" Click="OpenButton_Click" />
                    <Button x:Name="SnoozeButton" Content="Später erinnern" Padding="10,4"
                            Background="Transparent" Foreground="White" BorderThickness="1" BorderBrush="White"
                            Click="SnoozeButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Gezeichnetes Kreuz statt Unicode-Glyph (bekannte Render-Probleme, siehe
                 z. B. das "+"-Kreuz in AdminDashboardWindow.xaml). -->
            <Button Grid.Column="1" x:Name="CloseButton" Width="20" Height="20" Padding="0"
                    VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Click="CloseButton_Click">
                <Grid Width="12" Height="12">
                    <Rectangle Fill="White" Width="14" Height="2" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Fill="White" Width="14" Height="2" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="-45" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Button>
        </Grid>
    </Border>
</Window>
