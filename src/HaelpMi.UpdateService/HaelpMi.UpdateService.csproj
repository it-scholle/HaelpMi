<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HaelpMi.UpdateService</RootNamespace>
    <AssemblyName>HaelpMi.UpdateService</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsService>true</UseWindowsService>
  </PropertyGroup>

  <!-- CLAUDE.md: Windows-Dienst (LocalService/SYSTEM) AUSSCHLIESSLICH für Installieren/
       Testen/Swappen/Deinstallieren beim Auto-Update - alles andere (Alarmierung,
       Config-Sync, ...) bleibt in HaelpMi.Agent, der rechtelos im User-Kontext läuft.
       Microsoft.Extensions.Hosting.WindowsServices ist die offizielle .NET-Unterstützung
       dafür (SCM-Integration, Ereignisprotokoll) statt einer Eigenimplementierung. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HaelpMi.Core\HaelpMi.Core.csproj" />
  </ItemGroup>

</Project>
