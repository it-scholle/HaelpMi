<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HaelpMi.Notify</RootNamespace>
    <AssemblyName>HaelpMi.Notify</AssemblyName>
    <!-- Windows zeigt die Dateibeschreibung als Absender der Benachrichtigung. Bewusst ohne
         Produktnamen und ohne ApplicationIcon (neutrales Standardsymbol), damit Umstehende den
         stillen Alarm nicht erkennen. -->
    <AssemblyTitle>Arbeitsplatz-Dienst</AssemblyTitle>
    <Product>Arbeitsplatz-Dienst</Product>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

</Project>
