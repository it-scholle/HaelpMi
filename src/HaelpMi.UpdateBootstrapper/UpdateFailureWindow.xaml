<Window x:Class="HaelpMi.UpdateBootstrapper.UpdateFailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HälpMi Update"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True"
        Background="Transparent" AllowsTransparency="True">
    <!-- Ressourcen direkt hier gemergt statt über Application.Current (dieses Fenster läuft
         ohne eigene System.Windows.Application-Instanz, siehe UpdateFailureWindow.xaml.cs) -
         gleiches Muster wie AlarmPopupWindow/LicenseWarningToastWindow in HaelpMi.UI. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaelpMi.UI;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource DangerBrush}"
            BorderThickness="2" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <StackPanel Margin="0,0,0,16">
            <Border Background="{StaticResource DangerBrush}" CornerRadius="12,12,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <!-- Gezeichnetes Warndreieck statt Emoji/Font-Symbol - Codestil-Vorgabe
                         "gedrawte Vektor-Icon-Buttons statt Emoji" (bekannte Rendering-Bugs bei
                         Symbol-Glyphen, siehe AdminDashboardWindow-Kommentar zum "+"-Button). -->
                    <Canvas Width="22" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="M11,0 L22,20 L0,20 Z" Fill="White" />
                        <Rectangle Canvas.Left="9.5" Canvas.Top="6" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource DangerBrush}" />
                        <Ellipse Canvas.Left="9.5" Canvas.Top="15" Width="3" Height="3" Fill="{StaticResource DangerBrush}" />
                    </Canvas>
                    <StackPanel>
                        <TextBlock Text="HälpMi Update-Bootstrap" FontSize="12" Foreground="#FADBD8" />
                        <TextBlock Text="Update fehlgeschlagen" FontSize="18" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StepText" FontSize="12" FontWeight="SemiBold"
                       Margin="20,18,20,2" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock x:Name="MessageText" FontSize="14"
                       Margin="20,0,20,4" TextWrapping="Wrap" />
            <TextBlock x:Name="HintText" FontSize="12" Margin="20,8,20,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />

            <!-- Konsole bleibt für Diagnose offen (Flaw 14: darf weiterlaufen, ist aber nicht
                 mehr die primäre Nutzer-Ansicht) - dieser Hinweis sagt dem Admin, wo er
                 die vollständigen Details findet, falls er sie braucht. -->
            <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="4" Margin="20,14,20,14" Padding="10,8">
                <TextBlock Text="Der vollständige Ablauf steht weiterhin im Konsolenfenster im Hintergrund."
                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <Button x:Name="CloseButton" Content="Schließen" HorizontalAlignment="Right" Margin="0,0,20,0"
                    Padding="20,8" Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
