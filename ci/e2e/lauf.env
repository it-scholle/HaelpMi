# Laufparameter für einen E2E-Lauf über das Label "e2e" (.github/workflows/e2e.yml). workflow_dispatch nimmt
# stattdessen seine Inputs, kann aber nur Workflows vom Default-Branch starten. Leer = Standardlauf.
# Erlaubte Zeichen wie bei den Inputs, sonst bricht der Build-Job ab. Beispiel Vergleichslauf #136:
#   PRODUKT_REF=v0.46.1
#   FILTER=Bereich=Basis|Bereich=R136
#   ZYKLEN=25
PRODUKT_REF=v0.46.1
FILTER=Bereich=Basis|Bereich=R136
ZYKLEN=25
