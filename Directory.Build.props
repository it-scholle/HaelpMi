<Project>
  <PropertyGroup>
    <!-- Bugfix 06.08.2026 (Fehlerbericht "Dashboard zeigt Version 1.0.0 statt der
         tatsächlichen"): ohne dieses Property blieb jede Assembly beim .NET-Standardwert
         1.0.0.0 stehen (Assembly.GetExecutingAssembly().GetName().Version, siehe
         HaelpMi.Core/Runtime/LiveIdentityFactory.cs, CurrentProgramVersion) - unabhängig
         von der ganz anderen Versionsnummer, die der Inno-Setup-Installer anzeigt
         (installer/HaelpMiCommon.iss.inc, MyAppVersion). Directory.Build.props wird von
         MSBuild automatisch für jedes darunterliegende Projekt eingelesen, ohne dass jede
         .csproj es einzeln referenzieren muss - das ist hier keine unnötige
         Abstraktionsschicht, sondern schlicht der eine Ort, den MSBuild dafür vorsieht.
         Es gibt keine automatische Kopplung zwischen MSBuild und dem separaten ISPP-
         Toolchain des Installers - beide Werte müssen bei jedem Versionssprung von Hand
         synchron gehalten werden (gleiches Prinzip wie bei den Port-Konstanten, siehe
         Kommentar dort in HaelpMiCommon.iss.inc). -->
    <Version>0.42.2</Version>

    <!-- Nutzerwunsch 20.08.2026 ("alles außer de kann weg, ich brauche keine anderen
         Sprachen bisher") - ohne dieses Property bündelt jede self-contained-Publish-
         Ausgabe automatisch Satellite-Resource-DLLs (Fehlermeldungstexte der .NET/WPF-
         Runtime selbst, nicht unser eigener Code - wir haben keine eigenen .resx-Dateien)
         für rund ein Dutzend Sprachen (cs/es/fr/it/ja/ko/pl/pt-BR/ru/tr/zh-Hans/zh-Hant/...)
         in eigene Unterordner - das waren die vielen Sprachordner im Payload/Installer, die
         hier aufgefallen sind. MSBuild liest Directory.Build.props für jedes Projekt
         automatisch (wie bei <Version> oben), eine Sprache reicht daher an dieser einen
         Stelle für alle Projekte. -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
